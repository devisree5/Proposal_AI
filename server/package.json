{
  "name": "proposal-automation-server",
  "version": "1.0.0",
  "description": "Backend API for AI-Powered Email-to-Proposal Generation System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx src/prisma/db-setup.ts",
    "start": "tsx src/index.ts",
    "db:setup": "tsx src/prisma/db-setup.ts",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema src/prisma/schema.prisma",
    "prisma:seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "puppeteer": "^23.11.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/imap-simple": "^4.2.8",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
