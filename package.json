{
  "name": "propflow-ai-root",
  "version": "1.0.0",
  "description": "AI-Powered Email-to-Proposal Generation System",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client && npm run prisma:push --prefix server && npm run prisma:seed --prefix server",
    "install": "npm install --prefix client",
    "build": "npm run build --prefix client",
    "dev": "npm run dev --prefix client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test:features": "node verify_all_features.js"
  }
}
