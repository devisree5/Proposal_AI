PORT=5000
NODE_ENV=development
# For local SQLite: "file:./dev.db"
# For Render / Neon PostgreSQL: "postgresql://user:password@host:port/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Inbound & Outbound Email Integration (e.g. Gmail with App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-app-password"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993

# Default Company Information
COMPANY_NAME="PropFlow Solutions Inc."
COMPANY_EMAIL="proposals@propflow.ai"
COMPANY_PHONE="+1 (555) 392-8012"
COMPANY_ADDRESS="450 Market Street, Suite 800, San Francisco, CA"
CLIENT_URL="http://localhost:5173"
